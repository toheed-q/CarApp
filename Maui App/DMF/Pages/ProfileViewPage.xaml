<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:DMF.Pages.Controls"
             xmlns:viewModels="clr-namespace:DMF.PageModels"
             xmlns:converter="clr-namespace:DMF.Converters"
             BackgroundImageSource="profile_view_bg.jpg"
             xmlns:models="clr-namespace:DMF.Models"
             x:Class="DMF.Pages.ProfileViewPage"
             xmlns:f="clr-namespace:Fonts"
             Shell.NavBarIsVisible="False"
             Title="ProfileViewPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BoolToSvgConverter x:Key="BoolToSvgConverter"
                                          TrueIcon="selected_radio"
                                          FalseIcon="unselected_radio" />
            <converter:DisplayImageConverter x:Key="DisplayImageConverter" />
            <converter:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowSpacing="0"
          Padding="{OnIdiom '16,15,16,20', Desktop='48,30,48,30'}"
          RowDefinitions="Auto,*,Auto">

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              Margin="0,0,0,16">
            <Image Grid.Column="0"
                   VerticalOptions="Center"
                   Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_left_48_regular}, Color={x:StaticResource White}, Size=48}"
                   HeightRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1"
                   Text="Profile View"
                   FontSize="{OnIdiom 22, Desktop=30}"
                   TextColor="White"
                   FontFamily="PoppinsSemiBold"
                   VerticalTextAlignment="Center" />
        </Grid>

        <!-- ===== SCROLLABLE CONTENT ===== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Profile Info -->
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      Margin="0,0,0,16">
                    <Border Grid.Column="0"
                            HeightRequest="64"
                            WidthRequest="64"
                            Padding="0"
                            StrokeShape="RoundRectangle 32"
                            BackgroundColor="#333">
                        <Image Source="user_profile" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label FontSize="18"
                               TextColor="White"
                               Text="{Binding UserName}"
                               FontFamily="PoppinsSemiBold" />
                        <Label FontSize="13"
                               TextColor="#CCCCCC"
                               Text="{Binding UserCity}"
                               FontFamily="PoppinsRegular" />
                        <Label FontSize="13"
                               TextColor="{StaticResource DmfRed}"
                               Text="Edit Profile"
                               FontFamily="PoppinsRegular"
                               IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBool}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditProfileCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <!-- Services -->
                <VerticalStackLayout Padding="0,0,0,16" Spacing="10">
                    <Label Text="Services"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <HorizontalStackLayout Spacing="24">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image HeightRequest="22"
                                   Source="{Binding IsLoanSelected, Converter={StaticResource BoolToSvgConverter}}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceCommand}" CommandParameter="Loan" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Label Text="Loan" FontSize="13" TextColor="White" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image HeightRequest="22"
                                   Source="{Binding IsRegistrationSelected, Converter={StaticResource BoolToSvgConverter}}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceCommand}" CommandParameter="Registration" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Label Text="Registration" FontSize="13" TextColor="White" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image HeightRequest="22"
                                   Source="{Binding IsNocSelected, Converter={StaticResource BoolToSvgConverter}}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectServiceCommand}" CommandParameter="NOC" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Label Text="NOC" FontSize="13" TextColor="White" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Portfolio heading -->
                <Label Text="{Binding PortfolioHeading}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,10" />

                <!-- State container -->
                <Grid toolkit:StateContainer.CanStateChange="True"
                      toolkit:StateContainer.CurrentState="{Binding CurrentState}">
                    <toolkit:StateContainer.StateViews>

                        <!-- Loading state -->
                        <VerticalStackLayout toolkit:StateView.StateKey="Loading"
                                             HorizontalOptions="Center"
                                             Margin="0,40">
                            <ActivityIndicator IsRunning="True"
                                               Color="{StaticResource DmfRed}"
                                               HeightRequest="40" />
                        </VerticalStackLayout>

                        <!-- Success state -->
                        <CollectionView toolkit:StateView.StateKey="Success"
                                        ItemsSource="{Binding Cars}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CarFilterResult">
                                    <Border StrokeShape="RoundRectangle 16"
                                            Background="#171B25"
                                            Padding="12"
                                            Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="120,*"
                                              ColumnSpacing="12">

                                            <!-- Car Image -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding Images, Converter={StaticResource DisplayImageConverter}}"
                                                   HeightRequest="100"
                                                   WidthRequest="110"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center" />

                                            <!-- Details -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="5">

                                                <!-- Brand Model Year -->
                                                <Label TextColor="White"
                                                       FontFamily="PoppinsSemiBold"
                                                       FontSize="14">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Brand}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding Model}" />
                                                            <Span Text=" (" />
                                                            <Span Text="{Binding RegistrationDate, StringFormat='{0:yyyy}'}" />
                                                            <Span Text=")" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <!-- Tags -->
                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="{Binding KMDriven, StringFormat='{0:N0} Km'}"
                                                           Style="{StaticResource TagStyle}" />
                                                    <Label Text="{Binding Fuel}"
                                                           Style="{StaticResource TagStyle}" />
                                                    <Label Text="{Binding Transmission}"
                                                           Style="{StaticResource TagStyle}" />
                                                </HorizontalStackLayout>

                                                <!-- Price -->
                                                <Label TextColor="White"
                                                       FontFamily="PoppinsSemiBold"
                                                       FontSize="15"
                                                       Text="{Binding Price, StringFormat='₹{0:N2}'}" />

                                                <!-- Update date + Edit + Delete -->
                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                      ColumnSpacing="8"
                                                      Margin="0,2,0,0">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding CreatedDate, StringFormat='Update on: {0:dd MMM}'}"
                                                           FontSize="9"
                                                           TextColor="#AAAAAA"
                                                           VerticalTextAlignment="Center" />

                                                    <Button Grid.Column="1"
                                                            Text="Edit"
                                                            FontSize="12"
                                                            HeightRequest="34"
                                                            WidthRequest="70"
                                                            Padding="0"
                                                            CornerRadius="8"
                                                            TextColor="White"
                                                            BackgroundColor="#CA2F49"
                                                            IsVisible="{Binding CanManage}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCarCommand}"
                                                            CommandParameter="{Binding .}" />

                                                    <Button Grid.Column="2"
                                                            Text="Delete"
                                                            FontSize="12"
                                                            HeightRequest="34"
                                                            WidthRequest="70"
                                                            Padding="0"
                                                            CornerRadius="8"
                                                            TextColor="#CA2F49"
                                                            BackgroundColor="#F6C2CB"
                                                            IsVisible="{Binding CanManage}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCarCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>

                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No cars listed yet."
                                       TextColor="#AAAAAA"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,30" />
                            </CollectionView.EmptyView>
                        </CollectionView>

                    </toolkit:StateContainer.StateViews>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== BOTTOM BUTTONS ===== -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              Margin="0,12,0,0"
              IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBool}}">
            <Border Padding="0"
                    WidthRequest="60"
                    HeightRequest="60"
                    VerticalOptions="Center"
                    Background="{StaticResource DmfRed}"
                    StrokeShape="RoundRectangle 30">
                <Image Source="home"
                       HeightRequest="26"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <Border Grid.Column="1"
                    HeightRequest="60"
                    Background="#CA2F49"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">
                <HorizontalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="8">
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.add_circle_24_regular}, Color={x:StaticResource White}, Size=24}"
                           WidthRequest="24.33"
                           HeightRequest="24"
                           VerticalOptions="Center" />
                    <Label Text="Add Car"
                           TextColor="White"
                           FontSize="16"
                           FontFamily="PoppinsSemiBold"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToAddCarCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
