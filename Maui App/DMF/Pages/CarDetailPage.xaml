<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converter="clr-namespace:DMF.Converters"
             BackgroundImageSource="car_details"
             x:Class="DMF.Pages.CarDetailPage"
             xmlns:viewModels="clr-namespace:DMF.PageModels"
             Shell.NavBarIsVisible="False"
             xmlns:f="clr-namespace:Fonts"
             Title="CarDetailPage">
    <ContentPage.Resources>
        <converter:IsFavoriteColorConverter x:Key="IsFavoriteColorConverter" />
        <converter:ProfileImageConverter x:Key="ProfileImageConverter" />
        <!-- Same filled/outline heart images as the Home and Favorites lists -->
        <converter:BoolToSvgConverter x:Key="BoolToSvgConverter" TrueIcon="like" FalseIcon="unlike" />
    </ContentPage.Resources>

    <Grid>
        <!-- ================= CONTENT (image carousel + details) ================= -->
        <ScrollView VerticalScrollBarVisibility="Always">
            <VerticalStackLayout Spacing="16"
                                 MaximumWidthRequest="{OnIdiom 9999, Desktop=900}"
                                 HorizontalOptions="{OnIdiom Fill, Desktop=Center}">
                <!-- ===== Image carousel — swipe to browse, tap to open full-screen ===== -->
                <Grid HeightRequest="{OnIdiom 360, Desktop=460}"
                      IsClippedToBounds="True">
                    <CarouselView ItemsSource="{Binding CarDetail.Images}"
                                  Position="{Binding CurrentImageIndex}"
                                  Loop="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}"
                                       Aspect="AspectFill">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImageTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Left / right navigation (works alongside swipe) -->
                    <Border WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="#66000000"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Margin="10,0,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousImageCommand}" />
                        </Border.GestureRecognizers>
                        <Image HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_left_48_regular}, Color=White, Size=48}" />
                    </Border>

                    <Border WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="#66000000"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextImageCommand}" />
                        </Border.GestureRecognizers>
                        <Image HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_right_48_regular}, Color=White, Size=48}" />
                    </Border>

                    <!-- Counter (bottom-left, like a listing hero) -->
                    <Border Background="#AA000000"
                            Padding="12,5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            HorizontalOptions="Start"
                            VerticalOptions="End"
                            Margin="12,0,0,12">
                        <Label Text="{Binding ImageCounter}"
                               TextColor="White"
                               FontSize="12" />
                    </Border>

                    <!-- Transparent action strip (Back / Share / Favorite) over the hero image -->
                    <Grid Padding="16,14,16,0"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          VerticalOptions="Start">
                        <Image Grid.Column="0"
                               Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_left_48_regular}, Color={x:StaticResource White}, Size=48}"
                               HeightRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Grid.Column="2"
                               Source="share"
                               HeightRequest="20"
                               Margin="0,0,16,0"
                               VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Grid.Column="3"
                               Source="{Binding IsFavorite, Converter={StaticResource BoolToSvgConverter}}"
                               HeightRequest="24"
                               WidthRequest="24"
                               VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FavoriteCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>

                <!-- ===== DETAILS ===== -->
                <VerticalStackLayout Padding="16"
                                     Spacing="12">
                    <Label Text="{Binding CarDetail.Name}"
                           FontSize="{OnIdiom 22, Desktop=28}"
                           FontFamily="PoppinsSemiBold"
                           TextColor="White" />

                    <Label Text="{Binding CarDetail.PriceDisplay}"
                           FontSize="{OnIdiom 22, Desktop=28}"
                           FontFamily="PoppinsMedium"
                           TextColor="White" />

                    <!-- Car Overview -->
                    <Label Text="Car overview"
                           FontSize="16"
                           Margin="0,0,0,-8"
                           FontFamily="PoppinsMedium"
                           TextColor="White" />

                    <Grid ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="20"
                          ColumnSpacing="16">
                        <HorizontalStackLayout Grid.Row="0"
                                               Grid.Column="0"
                                               Spacing="8">
                            <Image Source="calendar"
                                   HeightRequest="21"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CarDetail.Registration_Date}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="0"
                                               Grid.Column="1"
                                               Spacing="8">
                            <Image Source="fule"
                                   HeightRequest="21"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CarDetail.Fuel}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="0"
                                               Grid.Column="2"
                                               Spacing="8">
                            <Image Source="car"
                                   HeightRequest="21"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CarDetail.Km}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>


                        <HorizontalStackLayout Grid.Row="1"
                                               Grid.Column="0"
                                               Spacing="8">
                            <Image Source="gear"
                                   HeightRequest="21"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CarDetail.Gear}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="1"
                                               Grid.Column="1"
                                               Spacing="8">
                            <Image Source="car"
                                   HeightRequest="21"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CarDetail.BodyType_Text}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                    </Grid>

                    <Label Text="Additional Details"
                           FontSize="16"
                           Margin="0,20,0,-10"
                           FontFamily="PoppinsMedium"
                           TextColor="White" />

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Negotiable:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.Negotiable_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Accidental:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.Accidental_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Service History:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.ServiceHistory_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Air Conditioning:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.AirConditioning_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Power Steering:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.PowerStaring_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Power Windows:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.PowerWindow_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="ABS:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.ABS_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Airbags:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.AirBag_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Bluetooth:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.Bluetooth_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Alloy Wheels:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.AlloyWheels_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Reverse Camera:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.ReverseCamera_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Sunroof:"
                                   FontSize="14"
                                   FontFamily="PoppinsSemiBold"
                                   TextColor="White" />
                            <Label Text="{Binding CarDetail.Sunroof_Text}"
                                   FontSize="14"
                                   FontFamily="PoppinsRegular"
                                   TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== POSTED BY ===== -->
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label FontSize="20"
                           FontAttributes="None"
                           CharacterSpacing="1.5"
                           Text="Posted by"
                           TextColor="White"
                           FontFamily="PoppinsMedium"
                           HorizontalTextAlignment="Center" />

                    <!-- Profile -->
                    <Border HeightRequest="60"
                            WidthRequest="60"
                            Padding="0"
                            StrokeShape="RoundRectangle 35"
                            BackgroundColor="#333">

                        <Image Source="{Binding SellerImage, Converter={StaticResource ProfileImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>

                    <!-- Name -->
                    <Label Text="{Binding CarDetail.DealerName}"
                           FontFamily="PoppinsRegular"
                           FontSize="18"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <!-- Date -->
                    <Label Text="{Binding CarDetail.PostedOn}"
                           FontFamily="PoppinsRegular"
                           FontSize="13"
                           TextColor="#CCCCCC"
                           HorizontalTextAlignment="Center" />





                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*">

                    <Button FontSize="{OnIdiom 18, Desktop=20}"
                            Margin="20,0"
                            Grid.Column="0"
                            CornerRadius="14"
                            Text="See Profile"
                            HeightRequest="{OnIdiom 56, Desktop=68}"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            FontFamily="PoppinsRegular"
                            TextColor="{StaticResource DmfRed}"
                            Command="{Binding ViewUserProfileCommand}"
                            BackgroundColor="{StaticResource DmfPink}" />

                    <Button Text="Call"
                            FontSize="{OnIdiom 18, Desktop=20}"
                            Margin="20,0"
                            Grid.Column="1"
                            CornerRadius="14"
                            ImageSource="call"
                            HeightRequest="{OnIdiom 56, Desktop=68}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"
                            Command="{Binding CallSellerCommand}"
                            BackgroundColor="{StaticResource DmfRed}" />
                </Grid>


            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>