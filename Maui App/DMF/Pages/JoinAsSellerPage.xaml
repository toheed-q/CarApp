<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:controls="clr-namespace:DMF.Pages.Controls"
             xmlns:converter="clr-namespace:DMF.Converters"
             x:Class="DMF.Pages.JoinAsSellerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#17171A">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16,15,16,16"
          RowSpacing="8">

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <Image Grid.Column="0"
                   VerticalOptions="Center"
                   HeightRequest="24"
                   Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_left_48_regular}, Color={x:StaticResource White}, Size=48}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1"
                   Text="Join as Seller"
                   FontSize="22"
                   TextColor="White"
                   FontFamily="PoppinsSemiBold"
                   VerticalTextAlignment="Center" />
        </Grid>

        <!-- ================= FORM ================= -->
        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0"
                                 Padding="4,16,4,8"
                                 MaximumWidthRequest="{OnIdiom 9999, Desktop=560}"
                                 HorizontalOptions="{OnIdiom Fill, Desktop=Center}">

                <!-- Icon badge -->
                <Border WidthRequest="80"
                        HeightRequest="80"
                        Padding="0"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        BackgroundColor="#CA2F49"
                        StrokeShape="RoundRectangle 40">
                    <Image HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HeightRequest="38"
                           Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.building_shop_24_regular}, Color=White, Size=76}" />
                </Border>

                <Label Text="Become a Dealer"
                       Margin="0,14,0,0"
                       FontSize="22"
                       FontFamily="PoppinsSemiBold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

                <Label Text="Fill in your details and submit for review. Our team will verify and enable dealer access on your account so you can list cars."
                       Margin="0,6,0,22"
                       FontSize="13.5"
                       LineHeight="1.4"
                       FontFamily="PoppinsRegular"
                       TextColor="#B4B4B4"
                       HorizontalTextAlignment="Center" />

                <!-- Name -->
                <Label Text="Name"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="PoppinsRegular"
                       Margin="0,0,0,4" />
                <controls:AdvancedEntryView Text="{Binding FullName}"
                                            Placeholder="Enter your name"
                                            ReturnType="Next"
                                            Margin="0,0,0,16" />

                <!-- Mobile no -->
                <Label Text="Mobile no"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="PoppinsRegular"
                       Margin="0,0,0,4" />
                <controls:AdvancedEntryView Text="{Binding PrimaryMobile}"
                                            Prefix="+91"
                                            EntryKeyboard="Telephone"
                                            Placeholder="Mobile number"
                                            ReturnType="Next"
                                            Margin="0,0,0,16" />

                <!-- Email id -->
                <Label Text="Email id"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="PoppinsRegular"
                       Margin="0,0,0,4" />
                <controls:AdvancedEntryView Text="{Binding Email}"
                                            Placeholder="Enter your Email id"
                                            EntryKeyboard="Email"
                                            ReturnType="Next"
                                            Margin="0,0,0,16" />

                <!-- Company / Business name -->
                <Label Text="Business / Company name"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="PoppinsRegular"
                       Margin="0,0,0,4" />
                <controls:AdvancedEntryView Text="{Binding CompanyName}"
                                            Placeholder="Your business name"
                                            ReturnType="Next"
                                            Margin="0,0,0,16" />

                <!-- Address -->
                <Label Text="Address"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="PoppinsRegular"
                       Margin="0,0,0,4" />
                <controls:AdvancedEntryView Text="{Binding Address1}"
                                            Placeholder="Enter your Address"
                                            ReturnType="Next"
                                            Margin="0,0,0,16" />

                <!-- State (dropdown) -->
                <controls:AdvancedPickerView Title="State"
                                             ItemsSource="{Binding States}"
                                             SelectedItem="{Binding State, Mode=TwoWay}"
                                             Margin="0,0,0,4" />

                <!-- City + Pin Code side by side -->
                <Grid ColumnDefinitions="*,16,*"
                      Margin="0,0,0,8">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="City"
                               TextColor="White"
                               FontSize="16"
                               FontFamily="PoppinsRegular" />
                        <controls:AdvancedEntryView Text="{Binding City}"
                                                    Placeholder="Your City"
                                                    ReturnType="Next" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Pin Code"
                               TextColor="White"
                               FontSize="16"
                               FontFamily="PoppinsRegular" />
                        <controls:AdvancedEntryView Text="{Binding Pincode}"
                                                    Placeholder="Your pin code"
                                                    EntryKeyboard="Numeric"
                                                    ReturnType="Done" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= SUBMIT ================= -->
        <Grid Grid.Row="2" Margin="0,4,0,8">
            <Button Text="Submit for Review"
                    HeightRequest="56"
                    CornerRadius="14"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#CA2F49"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Command="{Binding SubmitCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="White"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,0,20,0" />
        </Grid>
    </Grid>
</ContentPage>
