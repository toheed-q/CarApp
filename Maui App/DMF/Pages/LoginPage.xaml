<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:DMF.Pages.Controls"
             xmlns:local="clr-namespace:DMF.Pages.Behaviors"
             xmlns:viewModels="clr-namespace:DMF.PageModels"
             BackgroundImageSource="login_bg"
             Shell.NavBarIsVisible="False"
             x:Class="DMF.Pages.LoginPage">
    <!-- Row 0 is a flexible spacer (background art); row 1 is Auto so the form always
         gets the height it needs and GET OTP can never be clipped on short screens.
         The ScrollView lets the form scroll when the screen is too small for it. -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="{OnIdiom 24, Desktop=80}"
                             MaximumWidthRequest="{OnIdiom 9999, Desktop=600}"
                             HorizontalOptions="{OnIdiom Fill, Desktop=Center}">
            <Label Text="Login with&#10;mobile number"
                   FontSize="{OnIdiom 22, Desktop=30}"
                   CharacterSpacing="2"
                   Margin="0,10,0,0"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"
                   FontFamily="PoppinsRegular"
                   VerticalTextAlignment="Start"
                   HorizontalTextAlignment="Start"
                   TextColor="{StaticResource White}" />

            <VerticalStackLayout Spacing="20">
                <controls:AdvancedEntryView Prefix="+91 -"
                                            DigitsOnly="True"
                                            ReturnType="Next"
                                            EntryMaxLength="10"
                                            x:Name="MobileEntry"
                                            EntryKeyboard="Numeric"
                                            Text="{Binding MobileNumber}"
                                            Placeholder="Enter mobile number"
                                            HasError="{Binding HasMobileError}">
                </controls:AdvancedEntryView>


                <VerticalStackLayout Spacing="0">
                    <Label Text="Name"
                           FontSize="{OnIdiom 22, Desktop=26}"
                           FontFamily="PoppinsRegular"
                           TextColor="{StaticResource DmfGrayEA}" />

                    <controls:AdvancedEntryView ReturnType="Done"
                                                DigitsOnly="False"
                                                x:Name="NameEntry"
                                                Text="{Binding Name}"
                                                EntryKeyboard="Default"
                                                HasError="{Binding HasNameError}"
                                                Placeholder="Enter your name" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*"
                      VerticalOptions="Center">

                    <!-- Checkbox -->
                    <CheckBox IsChecked="{Binding IsTermsAccepted}"
                              Color="White"
                              VerticalOptions="Start" />

                    <!-- Text -->
                    <Label Grid.Column="1"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="White"
                           FontFamily="PoppinsRegular"
                           Margin="12,0,0,0">

                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="By clicking the checkbox, you agree with " />
                                <Span Text="Terms of Use"
                                      TextColor="{StaticResource DmfRed}"
                                      TextDecorations="Underline" />
                                <Span Text=", " />
                                <Span Text="Privacy Policy"
                                      TextColor="{StaticResource DmfRed}"
                                      TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>

                <Button Text="GET OTP"
                        FontSize="{OnIdiom 20, Desktop=22}"
                        CornerRadius="14"
                        HeightRequest="{OnIdiom 56, Desktop=68}"
                        Margin="0,0,0,16"
                        FontAttributes="Bold"
                        IsEnabled="{Binding IsTermsAccepted}"
                        BackgroundColor="{StaticResource DmfGray}"
                        TextColor="{StaticResource DmfBlack08090D}"
                        Command="{Binding NavigateToOTPVerificationCommand}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           Color="White"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Grid.RowSpan="2"
                           IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>