<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             xmlns:viewModels="clr-namespace:DMF.PageModels"
             x:Class="DMF.Pages.GetStartedPage"
             BackgroundImageSource="get_started_bg">
    <ContentPage.BindingContext>
        <viewModels:GetStartedPageModel/>
    </ContentPage.BindingContext>
    <!-- Row 0 is a flexible spacer so the background art shows; row 1 is Auto so the
         buttons always get exactly the height they need and can never be clipped on
         short screens. The ScrollView is a safety net for very small screens or large
         accessibility font scales. -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="10" Padding="0,12,0,24">
            <Label Text="Welcome to the&#10;DMF Motors"
                   FontSize="18"
                   CharacterSpacing="2"
                   Margin="0,10,0,0"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"
                   FontFamily="PoppinsRegular"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource White}" />

            <!-- New user: register via OTP -->
            <Button Margin="20,4,20,0"
                    FontSize="20"
                    CornerRadius="10"
                    Text="GET STARTED"
                    HorizontalOptions="Fill"
                    TextColor="{StaticResource White}"
                    BackgroundColor="{StaticResource DmfRed}"
                    Command="{Binding NavigateToHomePageCommand}" />

            <!-- Existing user: sign in with email + password -->
            <Button Margin="20,0,20,4"
                    FontSize="16"
                    CornerRadius="10"
                    Text="SIGN IN"
                    HorizontalOptions="Fill"
                    TextColor="{StaticResource DmfRed}"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource DmfRed}"
                    BorderWidth="1.5"
                    Command="{Binding NavigateToSignInCommand}" />
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>