<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:f="clr-namespace:Fonts"
               x:Class="DMF.Pages.Popups.SearchableSelectPopup"
               BackgroundColor="Transparent"
               Margin="0"
               Padding="0"
               HorizontalOptions="Fill"
               VerticalOptions="End"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <!-- Bottom sheet: docked to the bottom, dark, rounded top corners.
         Always dismissible (tap outside, the ✕ button, or picking a row). -->
    <Border BackgroundColor="#12141C"
            StrokeThickness="0"
            Padding="0"
            HorizontalOptions="Fill"
            StrokeShape="RoundRectangle 22,22,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto"
              BackgroundColor="#12141C">

            <!-- Header: title + close button -->
            <Grid Grid.Row="0"
                  Padding="20,16,14,8"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label x:Name="TitleLabel"
                       Text="Select"
                       FontSize="19"
                       FontAttributes="Bold"
                       FontFamily="PoppinsSemiBold"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Border Grid.Column="1"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="0"
                        StrokeThickness="0"
                        BackgroundColor="#23262F"
                        StrokeShape="RoundRectangle 17"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.dismiss_24_regular}, Color=White, Size=32}"
                           HeightRequest="16" WidthRequest="16"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="1"
                    x:Name="SearchBorder"
                    Margin="16,0,16,8"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#181A26"
                    StrokeThickness="0"
                    Padding="14,4">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.search_48_regular}, Color=White, Size=40}"
                           HeightRequest="18" WidthRequest="18"
                           VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           TextChanged="OnSearchChanged"
                           Placeholder="Search..."
                           PlaceholderColor="#B4B4B4"
                           BackgroundColor="Transparent"
                           TextColor="White"
                           FontSize="14" />
                </Grid>
            </Border>

            <!-- Body: list + empty state -->
            <Grid Grid.Row="2"
                  Margin="16,4,16,24">

                <Label x:Name="EmptyLabel"
                       IsVisible="False"
                       Text="No results"
                       TextColor="#B4B4B4"
                       FontFamily="PoppinsRegular"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <ScrollView x:Name="ItemsScroll"
                            MaximumHeightRequest="460"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="ItemsContainer"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="6,15">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRowTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           TextColor="White"
                                           FontFamily="PoppinsRegular"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                    <BoxView HeightRequest="1"
                                             Color="#23262F"
                                             VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
