<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:f="clr-namespace:Fonts"
               x:Class="DMF.Pages.Popups.SearchableSelectPopup"
               HorizontalOptions="Fill"
               VerticalOptions="End"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <!-- Reusable searchable bottom sheet for a plain list of strings
         (used for Brand and Model selection). -->
    <Border BackgroundColor="#12141C"
            StrokeThickness="0"
            Padding="0"
            HorizontalOptions="Fill"
            StrokeShape="RoundRectangle 22,22,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              BackgroundColor="#12141C">

            <!-- Grab handle -->
            <BoxView Grid.Row="0"
                     WidthRequest="42"
                     HeightRequest="5"
                     CornerRadius="3"
                     Color="#3A3F4E"
                     HorizontalOptions="Center"
                     Margin="0,12,0,2" />

            <!-- Header -->
            <Grid Grid.Row="1"
                  Padding="20,12,20,8">
                <Label x:Name="TitleLabel"
                       Text="Select"
                       FontSize="19"
                       FontAttributes="Bold"
                       FontFamily="PoppinsSemiBold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Search -->
            <Border Grid.Row="2"
                    x:Name="SearchBorder"
                    Margin="16,0,16,8"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#181A26"
                    StrokeThickness="0"
                    Padding="14,4">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.search_48_regular}, Color=White, Size=40}"
                           HeightRequest="18" WidthRequest="18"
                           VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           TextChanged="OnSearchChanged"
                           Placeholder="Search..."
                           PlaceholderColor="#B4B4B4"
                           BackgroundColor="Transparent"
                           TextColor="White"
                           FontSize="14" />
                </Grid>
            </Border>

            <!-- Body: list + empty state (sizes to content, capped by the ScrollView) -->
            <Grid Grid.Row="3"
                  Margin="16,4,16,20">

                <Label x:Name="EmptyLabel"
                       IsVisible="False"
                       Text="No results"
                       TextColor="#B4B4B4"
                       FontFamily="PoppinsRegular"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <ScrollView x:Name="ItemsScroll"
                            MaximumHeightRequest="460"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="ItemsContainer"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="6,15">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRowTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           TextColor="White"
                                           FontFamily="PoppinsRegular"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                    <BoxView HeightRequest="1"
                                             Color="#23262F"
                                             VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
