<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:f="clr-namespace:Fonts"
               xmlns:cities="clr-namespace:DMF.DTOs.Cities"
               x:Class="DMF.Pages.Popups.CitySelectionPopup"
               BackgroundColor="Transparent"
               Margin="0"
               Padding="0"
               HorizontalOptions="Fill"
               VerticalOptions="End"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <!-- Bottom sheet: docked to the bottom, dark, rounded top corners.
         Always dismissible (tap outside, the ✕ button, or picking a row). -->
    <Border BackgroundColor="#12141C"
            StrokeThickness="0"
            Padding="0"
            HorizontalOptions="Fill"
            StrokeShape="RoundRectangle 22,22,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              BackgroundColor="#12141C">

            <!-- Header: title + close button -->
            <Grid Grid.Row="0"
                  Padding="20,16,14,8"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="Select Location"
                       FontSize="19"
                       FontAttributes="Bold"
                       FontFamily="PoppinsSemiBold"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Border Grid.Column="1"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="0"
                        StrokeThickness="0"
                        BackgroundColor="#23262F"
                        StrokeShape="RoundRectangle 17"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.dismiss_24_regular}, Color=White, Size=32}"
                           HeightRequest="16" WidthRequest="16"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- City search -->
            <Border Grid.Row="1"
                    Margin="16,0,16,8"
                    StrokeShape="RoundRectangle 12"
                    Background="#181A26"
                    Padding="14,4">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.search_48_regular}, Color={StaticResource White}, Size=40}"
                           HeightRequest="18" WidthRequest="18"
                           VerticalOptions="Center" />
                    <Entry x:Name="CitySearchEntry"
                           Grid.Column="1"
                           TextChanged="OnCitySearchChanged"
                           Placeholder="Search city..."
                           PlaceholderColor="{StaticResource DmfGrayB4}"
                           BackgroundColor="Transparent"
                           TextColor="White"
                           FontSize="14" />
                </Grid>
            </Border>

            <!-- "All Locations" reset row -->
            <Border x:Name="AllLocationsRow"
                    Grid.Row="2"
                    Margin="16,0,16,4"
                    StrokeShape="RoundRectangle 12"
                    Background="#171B25"
                    Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAllLocationsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.location_48_regular}, Color={StaticResource White}, Size=40}"
                           HeightRequest="18" WidthRequest="18"
                           VerticalOptions="Center"
                           Margin="0,0,10,0" />
                    <Label Grid.Column="1"
                           Text="All Locations"
                           TextColor="White"
                           FontFamily="PoppinsRegular"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Body: Loading / Empty / List states -->
            <Grid Grid.Row="3"
                  Margin="16,4,16,24"
                  MinimumHeightRequest="340">

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="True"
                                   IsVisible="True"
                                   Color="{StaticResource DmfGrayB4}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                <Label x:Name="EmptyLabel"
                       IsVisible="False"
                       Text="No cities found"
                       TextColor="#B4B4B4"
                       FontFamily="PoppinsRegular"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <ScrollView x:Name="CitiesScroll"
                            IsVisible="False"
                            MaximumHeightRequest="460"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="CitiesContainer"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="cities:CityDto">
                                <Grid Padding="6,15">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCityRowTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding CityName}"
                                           TextColor="White"
                                           FontFamily="PoppinsRegular"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                    <BoxView HeightRequest="1"
                                             Color="#23262F"
                                             VerticalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>
