<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             x:Class="DMF.Pages.Controls.AdvancedPickerView">
    <VerticalStackLayout Spacing="0"
                         Margin="0,12,0,0"
                         BackgroundColor="Transparent">

        <!-- Field name — always visible so the user knows what the value below means -->
        <Label x:Name="FloatingLabel"
               TextColor="#AAAAAA"
               FontSize="13"
               FontFamily="PoppinsRegular"
               Margin="4,0,0,4" />

        <!-- Tappable value box — opens a dark selection sheet (consistent with the app) -->
        <Border x:Name="PickerBorder"
                Stroke="{StaticResource DmfGrayE6}"
                StrokeThickness="1"
                Background="Transparent"
                HeightRequest="56"
                Padding="16,0"
                StrokeShape="RoundRectangle 12">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto"
                  BackgroundColor="Transparent">
                <Label x:Name="ValueLabel"
                       Text="Select"
                       TextColor="#8A8A8A"
                       FontSize="16"
                       VerticalOptions="Center" />
                <Image Grid.Column="1"
                       VerticalOptions="Center"
                       HeightRequest="18"
                       Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_down_24_regular}, Color=White, Size=40}" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
