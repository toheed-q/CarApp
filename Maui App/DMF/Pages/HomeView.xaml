<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:controls="clr-namespace:DMF.Pages.Controls"
             xmlns:converter="clr-namespace:DMF.Converters"
             xmlns:models="clr-namespace:DMF.Models"
             xmlns:f="clr-namespace:Fonts"
             Loaded="HomeViewRoot_Loaded"
             x:Class="DMF.Pages.HomeView"
             x:Name="HomeViewRoot">

    <ContentView.Resources>
        <ResourceDictionary>
            <converter:DisplayImageConverter x:Key="DisplayImageConverter" />
            <converter:BoolToSvgConverter x:Key="BoolToSvgConverter" TrueIcon="like" FalseIcon="unlike"/>
            <DataTemplate x:Key="EmptyCarListTemplate">
                <controls:EmptyCarListTemplate />
            </DataTemplate>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid>
        <Image Source="get_started_bg"
               Aspect="AspectFill" />
        <Grid BackgroundColor="#55000000"></Grid>
        <Grid Padding="{OnIdiom '15,15,15,0', Desktop='30,30,30,0'}"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="10">
            <Border Grid.Row="0"
                    StrokeShape="RoundRectangle 30"
                    Background="#181A26"
                    Padding="{OnIdiom '15,5', Desktop='20,10'}">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.search_48_regular}, Color={StaticResource White}, Size=48}"
                           HeightRequest="{OnIdiom 20, Desktop=28}"
                           WidthRequest="{OnIdiom 20, Desktop=28}"
                           VerticalOptions="Center" />

                    <Entry FontSize="{OnIdiom 14, Desktop=18}"
                           Grid.Column="1"
                           VerticalOptions="Center"
                           Text="{Binding SearchText}"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource White}"
                           PlaceholderColor="{StaticResource DmfGrayB4}"
                           Placeholder="Search cars" />

                    <!-- 📍 Location selector -->
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0"
                            Background="#23262F"
                            Padding="{OnIdiom '10,6', Desktop='14,8'}"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectLocationCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6"
                                               VerticalOptions="Center">
                            <Image Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.location_48_regular}, Color={StaticResource White}, Size=40}"
                                   HeightRequest="{OnIdiom 16, Desktop=22}"
                                   WidthRequest="{OnIdiom 16, Desktop=22}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding LocationDisplay}"
                                   TextColor="{StaticResource White}"
                                   FontFamily="PoppinsRegular"
                                   FontSize="{OnIdiom 12, Desktop=15}"
                                   VerticalOptions="Center"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <!-- Clear button — only when a city is selected -->
                            <Image IsVisible="{Binding HasSelectedCity}"
                                   Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.dismiss_circle_20_regular}, Color={StaticResource DmfGrayB4}, Size=40}"
                                   HeightRequest="{OnIdiom 15, Desktop=20}"
                                   WidthRequest="{OnIdiom 15, Desktop=20}"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearLocationCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- 🎛 Filters -->
            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="5">
                    <Button Text="Filters"
                            ImageSource="filters"
                            Command="{Binding FilterCommand}"
                            Style="{StaticResource ChipButtonStyle}" />

                    <Button Text="Sort by"
                            ImageSource="sorting_arrows"
                            Command="{Binding SortCommand}"
                            Style="{StaticResource ChipButtonStyle}" />

                    <Button Text="Brand"
                            Command="{Binding BrandCommand}"
                            Style="{StaticResource ChipButtonStyle}" />

                    <Button Text="Model"
                            Command="{Binding ModelCommand}"
                            Style="{StaticResource ChipButtonStyle}" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- 🚗 Car List -->
            <Grid Grid.Row="2"
                  toolkit:StateContainer.CanStateChange="True"
                  toolkit:StateContainer.CurrentState="{Binding CurrentState}">
                <toolkit:StateContainer.StateViews>
                    <VerticalStackLayout toolkit:StateView.StateKey="Loading"
                                         BindableLayout.EmptyViewTemplate="{StaticResource EmptyCarListTemplate}" />

                    <!-- Empty State -->
                    <VerticalStackLayout toolkit:StateView.StateKey="Empty"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="0,60,0,0">
                        <Label Text="Result Not Found"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="PoppinsRegular"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding EmptyMessage}"
                               TextColor="#B4B4B4"
                               FontSize="13"
                               FontFamily="PoppinsRegular"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Error State (server unreachable / waking up) -->
                    <VerticalStackLayout toolkit:StateView.StateKey="Error"
                                         Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Margin="0,60,0,0">
                        <Label Text="Couldn't load cars"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="PoppinsRegular"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding EmptyMessage}"
                               TextColor="#B4B4B4"
                               FontSize="13"
                               FontFamily="PoppinsRegular"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                        <Button Text="Retry"
                                Command="{Binding LoadCarsCommand}"
                                BackgroundColor="{StaticResource DmfRed}"
                                TextColor="White"
                                CornerRadius="12"
                                WidthRequest="140"
                                HeightRequest="44"
                                Margin="0,4,0,0"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <CollectionView x:Name="CarList"
                                    SelectionMode="None"
                                    RemainingItemsThreshold="1"
                                    ItemsSource="{Binding Cars}"
                                    toolkit:StateView.StateKey="Success"
                                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCarsCommand}" VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CarFilterResult">
                                <Border StrokeShape="RoundRectangle 20"
                                        Background="#171B25"
                                        Padding="12"
                                        Margin="0,6">
                                    <Grid InputTransparent="False"
                                          ColumnSpacing="12"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{OnIdiom 110, Desktop=160}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Car Image — fixed box, clips any aspect ratio cleanly -->
                                        <Border Grid.RowSpan="3"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0"
                                                HeightRequest="{OnIdiom 100, Desktop=140}"
                                                WidthRequest="{OnIdiom 110, Desktop=160}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Start"
                                                Padding="0">
                                            <Image Source="{Binding Images, Converter={StaticResource DisplayImageConverter}}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="{OnIdiom 100, Desktop=140}"
                                                   WidthRequest="{OnIdiom 110, Desktop=160}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="CarDetailCommand_Tapped" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="6">
                                            <Label FontFamily="PoppinsRegular"
                                                   Text="{Binding Brand}"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   FontSize="{OnIdiom 15, Desktop=18}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <FormattedString.Spans>
                                                            <Span Text="{Binding Brand}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding Model}" />
                                                        </FormattedString.Spans>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="CarDetailCommand_Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding KMDriven}"
                                                       Style="{StaticResource TagStyle}" />
                                                <Label Text="{Binding Fuel}"
                                                       Style="{StaticResource TagStyle}" />
                                                <Label Text="{Binding Transmission}"
                                                       Style="{StaticResource TagStyle}" />
                                            </HorizontalStackLayout>

                                            <Label FontFamily="PoppinsRegular"
                                                   Text="{Binding PriceDisplay}"
                                                   TextColor="#FFFFFF"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom 15, Desktop=18}" />
                                            <HorizontalStackLayout Padding="0"
                                                                   Spacing="8"
                                                                   Margin="0,-10,0,0"
                                                                   HorizontalOptions="End"
                                                                   VerticalOptions="Center">
                                                <Label FontFamily="PoppinsRegular"
                                                       TextColor="#FFFFFF"
                                                       VerticalTextAlignment="Center"
                                                       FontAttributes="None"
                                                       FontSize="7">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <FormattedString.Spans>
                                                                <Span Text="Posted on: " />
                                                                <Span Text="{Binding CreatedDate, StringFormat='{0:dd MMM}'}" />
                                                            </FormattedString.Spans>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Image Source="{Binding IsWishlisted, Converter={StaticResource BoolToSvgConverter}}" HeightRequest="{OnIdiom 17, Desktop=24}" WidthRequest="{OnIdiom 17, Desktop=24}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="LikeUnlikeCommand_Tapped" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- 👆 Tap Gesture -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="CarDetailCommand_Tapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                               IsVisible="{Binding IsLoadingMore}" Color="{StaticResource DmfGrayB4}" />
                        </CollectionView.Footer>
                    </CollectionView>
                </toolkit:StateContainer.StateViews>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
