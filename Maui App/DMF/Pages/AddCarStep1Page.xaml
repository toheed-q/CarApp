<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DMF.Pages.Controls"
             xmlns:converters="clr-namespace:DMF.Converters"
             BackgroundImageSource="add_car_bg.jpg"
             BackgroundColor="#17171A"
             x:Class="DMF.Pages.AddCarStep1Page"
             xmlns:f="clr-namespace:Fonts"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid x:Name="Root"
          RowSpacing="20"
          Padding="16,15,16,20"
          RowDefinitions="Auto,*,Auto">
        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            <Image Grid.Column="0"
                   VerticalOptions="Center"
                   Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_left_48_regular}, Color={x:StaticResource White}, Size=48}"
                   HeightRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   FontSize="22"
                   TextColor="White"
                   FontFamily="PoppinsSemiBold"
                   VerticalTextAlignment="Center" />

            <Border Padding="0"
                    Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Background="{StaticResource DmfRed}"
                    StrokeShape="RoundRectangle 20,20,20,20">

                <Image Source="home"
                       HeightRequest="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="16"
                             Padding="0,20">

            <Label Text="1. Basic Car Details"
                   FontSize="22"
                   TextColor="White" />

            <!-- Brand (searchable dropdown from the CarBrandAndModel lookup) -->
            <Border Stroke="{StaticResource DmfGrayE6}"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    HeightRequest="56"
                    Padding="16,0"
                    StrokeShape="RoundRectangle 12"
                    Margin="0,12,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectBrandCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding BrandDisplay}"
                           TextColor="White"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <Image Grid.Column="1"
                           VerticalOptions="Center"
                           HeightRequest="20"
                           Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_down_24_regular}, Color={x:StaticResource White}, Size=40}" />
                </Grid>
            </Border>

            <!-- Model (searchable dropdown — only the selected brand's models) -->
            <Border Stroke="{StaticResource DmfGrayE6}"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    HeightRequest="56"
                    Padding="16,0"
                    StrokeShape="RoundRectangle 12"
                    Opacity="{Binding HasBrand, Converter={StaticResource BoolToOpacityConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectModelCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding ModelDisplay}"
                           TextColor="White"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <Image Grid.Column="1"
                           VerticalOptions="Center"
                           HeightRequest="20"
                           Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_down_24_regular}, Color={x:StaticResource White}, Size=40}" />
                </Grid>
            </Border>

            <!-- Variant (free text, e.g. Sigma / VXi) -->
            <controls:AdvancedEntryView Placeholder="Variant (e.g. Sigma, VXi)"
                                        Text="{Binding Car.Varient}" />

            <controls:AdvancedEntryView Placeholder="Year of Manufacture"
                                        EntryKeyboard="Numeric"
                                        Text="{Binding Car.YearOfManufacture}" />

            <controls:AdvancedEntryView Placeholder="Registration No"
                                        Text="{Binding Car.RegistrationNo}" />

            <controls:AdvancedPickerView Title="Fuel Type"
                                         ItemsSource="{Binding FuelTypes}"
                                         SelectedItem="{Binding Car.FuelType}" />

            <controls:AdvancedPickerView Title="Transmission"
                                         ItemsSource="{Binding Transmissions}"
                                         SelectedItem="{Binding Car.Transmission}" />

            <controls:AdvancedPickerView Title="Body Type"
                                         ItemsSource="{Binding BodyTypes}"
                                         SelectedItem="{Binding Car.BodyType}" />

            <!-- City (required) — opens the searchable city picker -->
            <Border Stroke="{StaticResource DmfGrayE6}"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    HeightRequest="56"
                    Padding="16,0"
                    StrokeShape="RoundRectangle 12"
                    Margin="0,12,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCityCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding CityDisplay}"
                           TextColor="White"
                           FontSize="16"
                           VerticalOptions="Center" />
                    <Image Grid.Column="1"
                           VerticalOptions="Center"
                           HeightRequest="20"
                           Source="{FontImageSource FontFamily=FluentUI, Glyph={x:Static f:FluentUI.chevron_down_24_regular}, Color={x:StaticResource White}, Size=40}" />
                </Grid>
            </Border>

        </VerticalStackLayout>
        </ScrollView>
        <Button Text="Next"
                Grid.Row="2"
                TextColor="White"
                Command="{Binding NextStep1Command}"
                BackgroundColor="{StaticResource DmfRed}" />
    </Grid>
</ContentPage>