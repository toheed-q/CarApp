{
  "_comment": "TEMPLATE — copy this file to 'appsettings.json' and replace the placeholder values. appsettings.json is git-ignored so your real secrets are never committed.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=ACD;Trusted_Connection=True;TrustServerCertificate=True;encrypt=false"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET",
    "Issuer": "DMF_Services",
    "Audience": "DMF_Clients",
    "ExpiryInDays": 7
  },
  "BlobStorage": {
    "ConnectionString": "PASTE_YOUR_AZURE_STORAGE_CONNECTION_STRING_HERE",
    "Container": "dmfcontainer"
  }
}
